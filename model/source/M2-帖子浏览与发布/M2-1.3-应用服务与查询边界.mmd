classDiagram
    direction LR
    class PostController
    class PostQueryService {
        +listPublic(query)
        +getPublicDetail(postId, viewerId)
        +batchGetPublicSummaries(postIds)
    }
    class PostService {
        +publish(userId, input, key)
        +listMine(userId, page)
        +edit(userId, postId, input)
        +delete(userId, postId)
    }
    class BoardService {
        +listActive()
    }
    class PublicAuthorView {
        +project(authorId)
    }
    class InteractionQueryService {
        +getVisibleComments(postId, page)
        +batchGetCounts(postIds)
    }
    PostController ..> PostQueryService
    PostController ..> PostService
    PostQueryService ..> BoardService : 板块筛选
    PostQueryService ..> PublicAuthorView : 公开投影
    PostQueryService ..> InteractionQueryService : M3 公开互动数据
    PostService ..> BoardService : 启用校验
